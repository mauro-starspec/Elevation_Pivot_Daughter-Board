  (text "PIVOT SERVO | ISOLATED MODBUS RTU, 2-WIRE RS-485"
    (at 20.32 17.78 0)
    (effects
      (font
        (size 1.778 1.778))
      (justify left top))
    (uuid "e44311d7-8bae-5298-8803-aba023e177cf"))
  (text "U160: RS-485 transceiver + galvanic isolation in one IC"
    (at 83.82 35.56 0)
    (effects
      (font
        (size 1.524 1.524))
      (justify left top))
    (uuid "6240a88d-c589-50b9-b88c-7ba465217f04"))
  (text "BUS BIAS / END TERMINATION"
    (at 238.76 35.56 0)
    (effects
