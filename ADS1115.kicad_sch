	(text "TH1 / TH2: two-pad 1206 thermistors, mounted on this PCB.\nPlace TH1 away from heat sources; TH2 near the selected power hot spot.\nBoth circuits stay in the +5V_BRAKE / GND_BRAKE domain; preserve isolation clearances."
		(exclude_from_sim no)
		(at 30.48 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "caa78df0-97e0-5416-8e81-c17e49e03b67")
	)
