  (text "STR8 CONTROL - STM32 SIGNALS ACTIVE HIGH\nPE9/TIM1_CH1 STEP: idle LOW; generate HIGH pulses, minimum 3 us.\nPE11 DIR: set direction before starting STEP pulses.\nPE13 STR8_DISABLE: HIGH = motor disabled; keep HIGH during reset/startup.\nPE14 STR8_FAULT: HIGH = fault; stop STEP and assert STR8_DISABLE.\nStartup: DISABLE HIGH -> configure STEP/DIR -> DISABLE LOW. STR8 S4 filter: 150 kHz.\n"
    (exclude_from_sim no)
    (at 21.336 23.368 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "3028e8a1-8992-4826-95ee-f9cbb820e190"))
