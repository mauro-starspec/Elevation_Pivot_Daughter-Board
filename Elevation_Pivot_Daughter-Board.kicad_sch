	)
	(text "NUCLEO CN14 RJ45 → Ethernet cable/switch → FMP100-50-IPM"
		(exclude_from_sim no)
		(at 60.96 13.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7414c2aa-5c88-4f08-91b5-f9c2913409ba")
	)
	(text "P3: motor encoders and two onboard thermistors; SSI retained.\nTemperature uses the existing ADS1115 spare inputs.\nPSRB handles external device power control.\nBattery and drive-current monitoring belong to other systems.\nPort / Star naming applies to all channels and their supplies.\nSchematic only; motor identity and harness remain unverified."
		(exclude_from_sim no)
