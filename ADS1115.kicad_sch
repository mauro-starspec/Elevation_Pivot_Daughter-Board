			)
			(justify left top)
		)
		(uuid "ec768cb5-a70d-545d-881a-480190f70a60")
	)
	(text "U21 AIN2 = TEMP_BOARD; AIN3 = TEMP_POWER. No added ICs or I2C addresses.\nFirmware: use +/-6.144 V range for AIN2/3; keep brake AIN0/1 at +/-4.096 V.\nUse TDK R/T curve 1010 and calibrated excitation voltage; voltage rises with temperature.\nReadings require the brake supply. Placement, calibration and cold testing remain to be done."
		(exclude_from_sim no)
		(at 30.48 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ecc1eaad-1391-5ab9-9ffa-688a0da5167d")
	)
