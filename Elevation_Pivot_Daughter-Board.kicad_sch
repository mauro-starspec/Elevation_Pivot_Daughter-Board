	(lib_symbols)
	(text "Up to 1.0 uF: Stick with 0805.\n1.0 uF to 10 uF: This is the \"gray area.\" Depends on the voltage. Try 1206\nAbove 10 uF: Switch to 1210."
		(exclude_from_sim no)
		(at 27.94 -45.466 0)
		(effects
